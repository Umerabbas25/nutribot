# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Option A — Neon free cloud (recommended): https://neon.tech → New Project → copy "Connection string"
# Option B — Local PostgreSQL: postgresql://postgres:yourpassword@localhost:5432/nutribot
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your-access-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# Custom string you define — paste same string in Meta dashboard webhook setup
WHATSAPP_VERIFY_TOKEN=nutribot_verify_2024

# App Secret from: Meta Dashboard → App Settings → Basic
WHATSAPP_APP_SECRET=your-app-secret-here

# ─── Resend ──────────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your-key-here

# Must be a verified domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NutriBot

# ─── Sentry ──────────────────────────────────────────────────────────────────
# Get from: https://sentry.io → Your Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL of your frontend (for CORS). Use * to allow all during development.
FRONTEND_URL=http://localhost:5500
